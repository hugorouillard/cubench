{
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "root": "..",
        "useIgnoreFile": true
    },
    "linter": {
        "domains": { "react": "recommended" },
        "rules": {
            "a11y": { "useSemanticElements": "off" }
        }
    },
    "formatter": {
        "enabled": true,
        "useEditorconfig": true
    }
}
